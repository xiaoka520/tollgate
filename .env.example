# Tollgate configuration (all optional — sane defaults for Solana devnet)
# Network label shown to callers: devnet | mainnet-beta
TOLLGATE_NETWORK=devnet

# Solana RPC endpoint
TOLLGATE_RPC_URL=https://api.devnet.solana.com

# HTTP port
PORT=8099

# Where gateway + invoice state is persisted
TOLLGATE_DATA_DIR=./.data

# Public base URL used to build the verify links returned in 402 challenges.
# Leave empty to auto-detect from the incoming request (X-Forwarded-* aware).
TOLLGATE_PUBLIC_URL=

# Default price per call, in lamports (1 SOL = 1_000_000_000 lamports)
TOLLGATE_PRICE_LAMPORTS=1000000

# Invoice lifetime in seconds
TOLLGATE_INVOICE_TTL=900
